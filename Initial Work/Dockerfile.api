# Use an official slim Python image as a small, supported base.
FROM python:3.11-slim-bullseye

# Set a working directory for the application files.
WORKDIR /app

# Make environment variables predictable and avoid Python buffering.
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV FRAUD_APP_ENV=production

# Install required system packages. build-essential is installed temporarily
# so Python packages that need compilation can build. Certificates and minimal
# runtime libraries are kept. Clean up apt lists to keep the image smaller.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      build-essential \
      gcc \
      libglib2.0-0 \
      libgl1 \
      ca-certificates \
      wget; \
    rm -rf /var/lib/apt/lists/*

# Copy only requirements first to leverage Docker layer caching.
COPY requirements.txt /app/requirements.txt

# Upgrade pip and install Python dependencies without cache.
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /app/requirements.txt

# After Python dependencies are installed, remove build tools to reduce image size
# and to reduce the attack surface. Keep required runtime libraries.
RUN set -eux; \
    apt-get purge -y build-essential gcc || true; \
    apt-get autoremove -y; \
    rm -rf /var/lib/apt/lists/*

# Create a non-root user and make the app directory owned by that user.
# Running the app as non-root improves security.
RUN groupadd --system app && useradd --system --gid app --home /app --create-home app

# Copy the application code and set ownership to the non-root user.
COPY --chown=app:app . /app

# Switch to the non-root user for running the application.
USER app

# Expose the port the app will run on.
EXPOSE 8000

# Default command to start the FastAPI app with uvicorn.
# Keeping a single worker here to match development behavior; adjust workers
# when scaling in production (for example, via a process manager).
CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
