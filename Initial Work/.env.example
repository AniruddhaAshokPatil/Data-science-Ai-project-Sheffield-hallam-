# I keep backend deployment settings here so production values can be copied
# into a real .env file without editing source code.
FRAUD_APP_ENV=production
FRAUD_APP_VERSION=1.0.0
FRAUD_LOG_LEVEL=INFO
FRAUD_HEURISTIC_THRESHOLD=0.65
FRAUD_ALLOWED_ORIGINS=http://localhost:8080
FRAUD_TRUSTED_HOSTS=localhost,127.0.0.1,fraud-api
FRAUD_RATE_LIMIT_REQUESTS=120
FRAUD_RATE_LIMIT_WINDOW_SECONDS=60
