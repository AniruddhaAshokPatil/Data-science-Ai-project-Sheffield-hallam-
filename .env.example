# ShieldWise local configuration example

SHIELDWISE_API_ENV=development
SHIELDWISE_DEBUG=false
SHIELDWISE_TOKEN_SECRET=change-me-before-production
SHIELDWISE_TOKEN_TTL_HOURS=8

SHIELDWISE_DATABASE_PATH=./data/processed/shieldwise_runtime.db
SHIELDWISE_EVIDENCE_UPLOADS_DIR=./data/raw/insurance_claims/uploads

SHIELDWISE_DEFAULT_USER_USERNAME=demo_user
SHIELDWISE_DEFAULT_USER_EMAIL=policyholder@example.com
SHIELDWISE_DEFAULT_USER_PASSWORD=UserPass123!

SHIELDWISE_DEFAULT_INVESTIGATOR_USERNAME=investigator_anna
SHIELDWISE_DEFAULT_INVESTIGATOR_EMAIL=anna.hughes@example.com
SHIELDWISE_DEFAULT_INVESTIGATOR_PASSWORD=InvestigatorPass123!
