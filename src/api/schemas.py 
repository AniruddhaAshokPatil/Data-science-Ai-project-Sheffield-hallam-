# src/api/schemas.py

from pydantic import BaseModel
import pandas as pd

class TransactionRequest(BaseModel):
    amount: float
    velocity_1h: float
    deviation: float
    frequency: float

    def to_dataframe(self):
        # I convert API input into model input format
        return pd.DataFrame([self.dict()])


class TextRequest(BaseModel):
    text: str